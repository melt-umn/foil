fun mandelbrot(c : complex, n : int) -> bool {
  var z = 0.0 +i 0.0;
  for (i in 0 : n) {
    if (real z * real z + imag z * imag z > 4.0) return false;
    z = z * z + c;
  }
  return true;
}

fun print_mandelbrot(w : int, h : int) {
  for (y in 0 : h) {
    for (x in 0 : w) {
      // Map pixel (x,y) → complex plane coordinate (c)
      var real_part = (2.47 * float(x)) / float(w - 1) - 2.0;
      var imag_part = (2.24 * float(y)) / float(h - 1) - 1.12;
      var c = real_part +i imag_part;

      // Print '.' if in the set, ' ' otherwise
      print(mandelbrot(c, 1000) ? "." : " ");
    }
    print("\n");
  }
}

fun main() {
  print_mandelbrot(160, 81);
}
